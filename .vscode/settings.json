{
  "files.exclude": {
    "**/.clj-kondo": true,
    "**/.cpcache": true,
    "**/.lsp": true,
    "**/.shadow-cljs": true,
    "**/node_modules": true
  },
  "task.allowAutomaticTasks": true,
  "debug.openDebug": "neverOpen",
  "terminal.integrated.inheritEnv": false,
  "tasks": {
    "label": "lint on open",
    "type": "shell",
    "command": "npm run lint",
    "runOn": "folderOpen"
  }
}
